<?xml version="1.0" encoding="utf-8"?>
<!--
  Иконка. Это не картинка, а три фигуры, поэтому остаётся резкой на любом
  экране и весит почти ничего.

  Читается так: экран, на нём строки текста, а средняя строка выделена
  зелёным — это и есть подставленный перевод.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Рамка экрана. -->
    <path
        android:pathData="M36,30 L72,30 A6,6 0 0 1 78,36 L78,72 A6,6 0 0 1 72,78 L36,78 A6,6 0 0 1 30,72 L30,36 A6,6 0 0 1 36,30 Z"
        android:fillColor="#00000000"
        android:strokeColor="@color/ic_launcher_text"
        android:strokeWidth="5"
        android:strokeLineJoin="round" />

    <!-- Строка оригинала. -->
    <path
        android:pathData="M40,42 h28 v5 h-28 z"
        android:fillColor="@color/ic_launcher_text" />

    <!-- Строка перевода. -->
    <path
        android:pathData="M40,52 h28 v5 h-28 z"
        android:fillColor="@color/ic_launcher_accent" />

    <!-- Хвост строки, чтобы строки выглядели разными. -->
    <path
        android:pathData="M40,62 h20 v5 h-20 z"
        android:fillColor="@color/ic_launcher_text" />
</vector>
